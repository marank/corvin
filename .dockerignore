# Build context: only what the Dockerfile copies needs to be here; the image installs its own
# dependencies and builds the SPA itself.
.git
.github
.env
.env.*
!.env.example
*.local
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.coverage
**/htmlcov
backend/.venv
backend/db.sqlite3*
backend/media
backend/staticfiles
frontend/node_modules
frontend/dist
frontend/coverage
