{
  // Everyday commands. Each task calls a recipe of the justfile, where the commands live
  // (and which CI runs too), so nothing has to be kept in sync here.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Django (:8000) and Vite (:5173) dev servers",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "just dev-backend",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "just dev-frontend",
      "isBackground": true,
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "check",
      "detail": "Everything CI checks, backend and frontend",
      "type": "shell",
      "command": "just check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "check: backend",
      "detail": "ruff, mypy, deptry, licenses, migrations, Django checks, OpenAPI, pytest",
      "type": "shell",
      "command": "just check-backend",
      "problemMatcher": []
    },
    {
      "label": "check: frontend",
      "detail": "lint, formatting, types, tests, API types, build, licenses, audit",
      "type": "shell",
      "command": "just check-frontend",
      "problemMatcher": []
    },
    {
      "label": "api: types",
      "detail": "After API changes: export openapi.json and regenerate src/api/schema.d.ts",
      "type": "shell",
      "command": "just api-types",
      "problemMatcher": []
    },
    {
      "label": "django: makemigrations",
      "type": "shell",
      "command": "just migrations",
      "problemMatcher": []
    },
    {
      "label": "django: migrate",
      "type": "shell",
      "command": "just migrate",
      "problemMatcher": []
    },
    {
      "label": "docker: up",
      "detail": "Build and start the production stack (needs .env)",
      "type": "shell",
      "command": "just docker-up",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "just docker-down",
      "problemMatcher": []
    },
    {
      "label": "docker: backup now",
      "detail": "Database dump + uploads tarball into the backups volume",
      "type": "shell",
      "command": "just docker-backup",
      "problemMatcher": []
    }
  ]
}
