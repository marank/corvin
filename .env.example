# Configuration for docker compose: save as .env next to compose.yml and fill in.
# Never commit .env. Native development: see docs/development.md.

# --- Application ----------------------------------------------------------------
# Every URL users open Corvin under, comma separated (scheme, host and port if not
# default). The first one is the public address: links that leave the browser use it,
# e.g. {{ app_url }} in invoice mails. Allowed hosts and CSRF trusted origins are
# derived from all of them. Once every URL is https, cookies are sent over https only;
# use https URLs only once a TLS proxy is in front. The http→https redirect and HSTS
# are that proxy's job, Corvin sets neither.
APP_URLS=http://localhost
# Host port the app container (nginx) is published on.
APP_PORT=80
# Image to run. Default: ghcr.io/marank/corvin:latest. Pin a version with
# ghcr.io/marank/corvin:1.2 (or 1.2.3, 1, sha-<commit>).
#APP_IMAGE=ghcr.io/marank/corvin:latest

# Address(es) of the TLS proxy in front of the app container (Caddy, Traefik, nginx, …),
# comma separated IPs or CIDR ranges. Only from these does nginx accept
# X-Forwarded-For/-Proto, i.e. the client's address and HTTPS. Required with https
# URLs in APP_URLS: without it every request looks like plain http to Django and all
# users share the proxy's address for the login rate limit.
# Proxy in the same Docker network or on the host: e.g. 172.16.0.0/12. Empty: clients
# connect directly.
TRUSTED_PROXIES=

# Signs sessions, CSRF tokens and password reset links. Random string of at least 40
# characters, Corvin refuses to start otherwise; changing it logs everybody out.
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me
# Time zone for dates, invoice numbering and the job times below.
TIME_ZONE=Europe/Berlin
# Language of documents (PDFs, previews, mails) and of server messages when the
# browser asks for none of de/en.
LANGUAGE_CODE=de
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created on start if the user does not exist) ---------
ADMIN_USERNAME=admin
ADMIN_EMAIL=it@example.com
# Only used when the user is created, exactly as written here. Change it later with
#   docker compose exec app python manage.py set_password admin
ADMIN_PASSWORD=change-me

# Let people create their own account on the login page (true/false). Off: accounts
# are created by an admin (Django admin or `manage.py createsuperuser`).
REGISTRATION_ENABLED=false

# --- Email ----------------------------------------------------------------------
# SMTP server for invoice mails.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=invoices@example.com

# --- Database -------------------------------------------------------------------
# PostgreSQL in the db container. The password only applies on the first start;
# changing it later has no effect on the existing database.
DB_NAME=corvin
DB_USER=corvin
DB_PASSWORD=change-me

# --- Jobs and backups -----------------------------------------------------------
# Daily times (HH:MM in TIME_ZONE) for the worker's jobs. Not between 02:00 and 03:00,
# which daylight saving time skips or repeats once a year.
# Invoices for due support contracts:
RECURRING_TIME=06:00
# Database dump + tarball of the uploads into the "backups" volume, and how many days of
# backups to keep (restore: docs/operations.md):
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14
# Empty switches the nightly backup off. Default: /backups (the "backups" volume).
#BACKUP_DIR=/backups
# Jobs the worker runs at the same time (mails, PDFs). Default: 2.
#WORKER_CONCURRENCY=2

# --- Server ---------------------------------------------------------------------
# Gunicorn processes in the app container, each needs roughly 50-150 MB RAM (PDF
# rendering more). Rule of thumb: 2 x CPU cores + 1. Default: 3.
#GUNICORN_WORKERS=3
