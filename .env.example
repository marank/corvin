# Copy to .env and adjust. Used by docker-compose (prod) and Django.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost
CSRF_TRUSTED_ORIGINS=https://your-domain.com
REGISTRATION_OPEN=False
TIME_ZONE=Europe/Berlin

# Database (postgres in compose; sqlite default locally)
DATABASE_URL=postgres://pm:pm@db:5432/projectmanager
POSTGRES_DB=projectmanager
POSTGRES_USER=pm
POSTGRES_PASSWORD=pm

# Email (SMTP in prod; console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=invoices@your-domain.com

# Windows dev only: override if MSYS2 lives elsewhere
# MSYS2_BIN_DIR=C:\msys64\ucrt64\bin
