# Copy to .env and adjust: `cp .env.example .env`. Never commit .env.
# Native development reads it directly (backend/config/settings.py); docker compose
# passes it into the containers and overrides a few values (see below).

# --- Application ----------------------------------------------------------------
# Development mode (true/false): fixed dev SECRET_KEY, localhost allowed, mails on the
# console. Only for native development; docker compose always sets DEBUG=false.
DEBUG=true
# Every URL users open Corvin under, comma separated (scheme, host and port if not
# default). Allowed hosts and CSRF trusted origins are derived from it. Once every URL
# is https, cookies are sent over https only; use https URLs only once a TLS proxy is in
# front. The http→https redirect and HSTS are that proxy's job, Corvin sets neither.
# Native development additionally allows localhost:8000 / :5173.
APP_URLS=http://localhost
# Host port of the frontend container (nginx).
APP_PORT=80
# Image docker compose runs (app, scheduler, backup). Default:
# ghcr.io/marank/corvin:latest. Pin a version with ghcr.io/marank/corvin:1.2 (or 1.2.3, 1,
# sha-<commit>); `just docker-up` builds `corvin` from the checkout and uses that.
#APP_IMAGE=ghcr.io/marank/corvin:latest

# Address(es) of the TLS proxy in front of the frontend container (Caddy, Traefik,
# nginx, …), comma separated IPs or CIDR ranges. Only from these does nginx accept
# X-Forwarded-For/-Proto, i.e. the client's address and HTTPS. Required with https
# URLs in APP_URLS: without it every request looks like plain http to Django and all
# users share the proxy's address for the login rate limit.
# Proxy in the same Docker network or on the host: e.g. 172.16.0.0/12. Empty: clients
# connect directly.
TRUSTED_PROXIES=

# Signs sessions, CSRF tokens and password reset links. Long random string (at least
# 40 characters; production refuses to start otherwise); changing it logs everybody
# out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# With DEBUG=true a fixed development key is used while this is still the placeholder.
SECRET_KEY=change-me
# Time zone for dates, invoice numbering, the scheduler and the backup times.
TIME_ZONE=Europe/Berlin
# Language of documents (PDFs, previews, mails) and of server messages when the
# browser asks for none of de/en.
LANGUAGE_CODE=de
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created on start if the user does not exist) ---------
ADMIN_USERNAME=admin
ADMIN_EMAIL=it@example.com
# Only used when the user is created, exactly as written here. Change it later with
#   docker compose exec app python manage.py set_password admin
# (takes any password; changepassword enforces the password rules). Natively:
# `uv run python manage.py ensure_admin` / `set_password admin` in backend/.
ADMIN_PASSWORD=change-me

# Let people create their own account on the login page (true/false). Off: accounts
# are created by an admin (Django admin or `manage.py createsuperuser`).
REGISTRATION_ENABLED=false

# --------------------------------------------------------------------------- email
# SMTP server for invoice mails. Natively the console backend prints mails instead.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=invoices@example.com
# Override the mail backend (default: console natively, SMTP in docker compose).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ------------------------------------------------------------------------ database
# sqlite (file backend/db.sqlite3) or postgres. docker compose always runs Postgres
# with the values below and sets DB_TYPE=postgres, DB_HOST=db inside the containers.
# Changing DB_PASSWORD after the first start has no effect on the existing database.
DB_TYPE=sqlite
DB_NAME=corvin
DB_USER=corvin
DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------- jobs and backups
# The worker container runs the background jobs (core/tasks.py): invoice mails, and daily
# at these times of day in TIME_ZONE (HH:MM; not between 02:00 and 03:00, which daylight
# saving time skips or repeats once a year). Natively on SQLite there is no worker: mails
# go out right away, the daily jobs don't run.
# Invoices for due support contracts:
RECURRING_TIME=06:00
# Database dump + tarball of the uploads into the "backups" volume, and how many days of
# backups to keep:
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=14
# Where backups go. The image sets /backups (the "backups" volume); empty switches the
# nightly backup off.
#BACKUP_DIR=/backups
# Jobs the worker runs at the same time (mails, PDFs); default 2.
#WORKER_CONCURRENCY=2

# -------------------------------------------------------------------------- server
# Gunicorn worker processes in the backend container; each handles one request at a
# time and needs roughly 50-150 MB RAM (PDF rendering more). Rule of thumb:
# 2 x CPU cores + 1. Default: 3.
# GUNICORN_WORKERS=3

# --- Windows development only -------------------------------------------------
# Override if MSYS2 (WeasyPrint's Pango runtime) lives elsewhere.
# MSYS2_BIN_DIR=C:\msys64\ucrt64\bin
