# Configuration for Docker Compose (production) and for native development.
# Copy to .env and adjust: `cp .env.example .env`. Never commit .env.
# Django reads backend/.env natively; docker-compose.yml reads this file from the repo root.

# --- Django -------------------------------------------------------------------

# Signs sessions, CSRF tokens and password reset links. Long and random; changing it
# logs everybody out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Never true in production: shows stack traces and serves debug pages.
# Docker always uses config.settings.production, which forces DEBUG off.
DEBUG=False

# Host names Django answers to (comma separated). The first one is also used by the
# container healthcheck as Host header.
ALLOWED_HOSTS=your-domain.com,localhost

# Origins allowed to send forms/API writes with the session cookie (scheme + host).
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Allows self sign-up via /api/v1/auth/register. Keep False on a public server.
REGISTRATION_OPEN=False

# Time zone for dates, invoice numbering, the scheduler and the backup times.
TIME_ZONE=Europe/Berlin

# Production redirects plain http to https. Only set to False when the app is
# reachable on plain http on purpose (e.g. only inside a VPN).
# SECURE_SSL_REDIRECT=True

# --- Reverse proxy ------------------------------------------------------------

# Addresses/CIDRs (comma separated) of the TLS proxy in front of the frontend
# container (Caddy, Traefik, nginx, …). Only from these does nginx accept
# X-Forwarded-For / X-Forwarded-Proto. Required behind a TLS proxy: without it every
# request looks like plain http (the SSL redirect then loops) and all users share
# the proxy's address for the login rate limit.
# Proxy in the same Docker network or on the host: e.g. 172.16.0.0/12
TRUSTED_PROXIES=

# Host port of the frontend container (nginx).
HTTP_PORT=80

# --- Database -----------------------------------------------------------------

# Natively: SQLite in backend/db.sqlite3 unless DATABASE_URL is set.
# Docker builds DATABASE_URL from the POSTGRES_* values below and ignores this line.
DATABASE_URL=postgres://corvin:corvin@db:5432/corvin

# PostgreSQL in Docker. Generate the password like SECRET_KEY. Changing it after the
# first start has no effect on the existing database.
POSTGRES_DB=corvin
POSTGRES_USER=corvin
POSTGRES_PASSWORD=change-me

# --- Email --------------------------------------------------------------------

# SMTP in production; natively the console backend prints mails instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=invoices@your-domain.com

# --- Jobs and backups (Docker) ------------------------------------------------

# Daily run of process_recurring (invoices for due support contracts), HH:MM in TIME_ZONE.
RECURRING_TIME=06:00

# Daily database dump + tarball of uploads into the "backups" volume, HH:MM in TIME_ZONE.
BACKUP_TIME=02:30
# Backups older than this many days are deleted.
BACKUP_KEEP_DAYS=14

# --- Windows development only -------------------------------------------------

# Override if MSYS2 (WeasyPrint's Pango runtime) lives elsewhere.
# MSYS2_BIN_DIR=C:\msys64\ucrt64\bin
