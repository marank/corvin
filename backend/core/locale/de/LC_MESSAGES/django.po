msgid "Project does not belong to the selected customer."
msgstr "Das Projekt gehört nicht zum ausgewählten Kunden."

msgid "Project does not belong to the customer."
msgstr "Das Projekt gehört nicht zu diesem Kunden."

msgid "Visit does not belong to the entry's customer."
msgstr "Der Termin gehört nicht zum Kunden des Eintrags."

msgid "Contract does not belong to the entry's customer."
msgstr "Der Vertrag gehört nicht zum Kunden des Eintrags."

msgid "Contract is limited to a different project."
msgstr "Der Vertrag gilt nur für ein anderes Projekt."

#, python-format
msgid "Invalid template: %(error)s"
msgstr "Ungültige Vorlage: %(error)s"

msgid "Invalid object."
msgstr "Ungültige Auswahl."

msgid "A key is required."
msgstr "Ein Schlüssel ist erforderlich."

msgid "Invalid counter scope."
msgstr "Ungültiger Zählerbereich."

msgid "A format is required."
msgstr "Ein Format ist erforderlich."

msgid "Maximum length is 200 characters."
msgstr "Höchstens 200 Zeichen."

msgid "Must be a positive integer."
msgstr "Muss eine positive ganze Zahl sein."

msgid "Invalid bank account."
msgstr "Ungültiges Bankkonto."

msgid "Must differ from decimal separator."
msgstr "Muss sich vom Dezimaltrennzeichen unterscheiden."

msgid "Use a three-letter ISO currency code."
msgstr "Bitte einen dreistelligen ISO-Währungscode angeben."

#, python-format
msgid "Unknown entities: %(names)s."
msgstr "Unbekannte Objekttypen: %(names)s."

msgid "Must be an object."
msgstr "Muss ein Objekt sein."

#, python-format
msgid "Unknown report types: %(names)s."
msgstr "Unbekannte Belegtypen: %(names)s."

msgid "Choose a template."
msgstr "Wähle eine Vorlage."

msgid "Invalid template."
msgstr "Ungültige Vorlage."

#, python-format
msgid "Unknown mail kinds: %(names)s."
msgstr "Unbekannte E-Mail-Arten: %(names)s."

msgid "The template has no subject; it cannot be sent."
msgstr "Die Vorlage hat keinen Betreff und kann so nicht versendet werden."

msgid "Enter a CSS color, e.g. #1f2937."
msgstr "Bitte eine CSS-Farbe angeben, z. B. #1f2937."

msgid "Font names must not contain ; { } < > or backslashes."
msgstr "Schriftnamen dürfen weder ; { } < > noch Backslashes enthalten."

msgid "All contacts must belong to the invoice customer."
msgstr "Alle Kontakte müssen zum Kunden der Rechnung gehören."

msgid "Activity report"
msgstr "Tätigkeitsbericht"

msgctxt "time report"
msgid "Item"
msgstr "Pos."

msgctxt "time report"
msgid "Total"
msgstr "Gesamt"

#, python-format
msgid "No hourly rate found for %(customer)s on %(date)s."
msgstr "Für %(customer)s ist am %(date)s kein Stundensatz hinterlegt."

msgid "Services"
msgstr "Leistungen"

#, python-format
msgid "Unknown grouping: %(group_by)s"
msgstr "Unbekannte Gruppierung: %(group_by)s"

msgid "A line bills time entries that are not open or twice."
msgstr ""
"Eine Position rechnet Zeiten ab, die nicht offen sind oder doppelt vorkommen."

msgid "No billable, uninvoiced time entries found."
msgstr "Keine abrechenbaren, noch nicht abgerechneten Zeiteinträge gefunden."

msgid "Only draft invoices can be edited."
msgstr "Nur Rechnungsentwürfe können bearbeitet werden."

msgid "The customer of an invoice cannot be changed."
msgstr "Der Kunde einer Rechnung kann nicht geändert werden."

msgid "Invoice has no line items."
msgstr "Die Rechnung hat keine Positionen."

#, python-format
msgid "Missing required fields: %(fields)s"
msgstr "Pflichtangaben fehlen: %(fields)s"

msgid "The file is no PDF."
msgstr "Die Datei ist kein PDF."

msgid "The file is no XML."
msgstr "Die Datei ist kein XML."

msgid "This number is already taken."
msgstr "Diese Nummer ist bereits vergeben."

msgid "Some time entries are not open (any more)."
msgstr "Einige Zeiten sind nicht (mehr) offen."

msgid "As per the attached invoice"
msgstr "Laut beigefügter Rechnung"

msgid "A template cannot build on itself."
msgstr "Eine Vorlage kann nicht auf sich selbst aufbauen."

msgid "With a base, everything goes inside blocks; the rest would not show."
msgstr "Mit Basis gehört alles in Blöcke, der Rest würde nicht angezeigt."

#, python-format
msgid "The base has no block %(names)s."
msgstr "Die Basis hat keinen Block %(names)s."

#, python-format
msgid "%(names)s and %(last)s"
msgstr "%(names)s und %(last)s"

msgid "Only finalized invoices can be sent."
msgstr "Nur finalisierte Rechnungen können versendet werden."

msgid "The number cannot be empty."
msgstr "Die Nummer darf nicht leer sein."

msgid "The number appears on a finalized invoice and can no longer be changed."
msgstr ""
"Die Nummer steht auf einer finalisierten Rechnung und kann nicht mehr "
"geändert werden."

msgid "Consulting"
msgstr "Beratung"

msgid "On-site support"
msgstr "Vor-Ort-Einsatz"

msgid "Invoice"
msgstr "Rechnung"

msgid "Time report"
msgstr "Leistungsnachweis"

