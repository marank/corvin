msgid "Invalid credentials."
msgstr "Benutzername oder Passwort ist falsch."

msgid "Invalid code."
msgstr "Der Code ist ungültig."

msgid "Username already taken."
msgstr "Der Benutzername ist bereits vergeben."

msgid "Registration is disabled."
msgstr "Die Registrierung ist deaktiviert."

msgid "This entry is still used by other records and cannot be deleted."
msgstr ""
"Dieser Eintrag wird noch von anderen Daten verwendet und kann nicht gelöscht "
"werden."

msgid ""
"This customer still has invoices or time entries and cannot be deleted. "
"Deactivate the customer instead."
msgstr ""
"Zu diesem Kunden gibt es noch Rechnungen oder Zeiteinträge, daher kann er "
"nicht gelöscht werden. Bitte den Kunden stattdessen deaktivieren."

msgid "The last template cannot be deleted."
msgstr "Die letzte Vorlage kann nicht gelöscht werden."

#, python-format
msgid "%(name)s (copy)"
msgstr "%(name)s (Kopie)"

msgid "Invalid template file."
msgstr "Die Vorlagendatei ist ungültig."

msgid "Unsupported template format or version."
msgstr "Dieses Vorlagenformat bzw. diese Version wird nicht unterstützt."

msgid "Only draft invoices can be deleted."
msgstr "Nur Rechnungsentwürfe können gelöscht werden."

msgid "Invalid customer."
msgstr "Ungültiger Kunde."

msgid "Invalid project."
msgstr "Ungültiges Projekt."

msgid "Invalid contacts."
msgstr "Ungültige Kontakte."

msgid "Invoice already finalized."
msgstr "Die Rechnung ist bereits finalisiert."

msgid "No bank account with an IBAN for this invoice."
msgstr "Für diese Rechnung ist kein Bankkonto mit IBAN hinterlegt."

msgid "Only issued invoices can be marked as sent."
msgstr "Nur ausgestellte Rechnungen können als gesendet markiert werden."

msgid "The sending date cannot be in the future."
msgstr "Das Versanddatum darf nicht in der Zukunft liegen."

msgid "The sending date cannot be before the issue date."
msgstr "Das Versanddatum darf nicht vor dem Rechnungsdatum liegen."

msgid "Paid invoices cannot be cancelled."
msgstr "Bezahlte Rechnungen können nicht storniert werden."

msgid "Unknown mail kind."
msgstr "Unbekannte E-Mail-Art."

msgid "A line item cannot be moved to another invoice."
msgstr "Eine Position kann nicht in eine andere Rechnung verschoben werden."

msgid "The template is assigned to a mail kind."
msgstr "Die Vorlage ist einer E-Mail-Art zugeordnet."

#, python-format
msgid "Templates build on it: %(names)s."
msgstr "Darauf bauen Vorlagen auf: %(names)s."

msgid "Wrong password."
msgstr "Das Passwort ist falsch."

msgid "At least 8 characters."
msgstr "Mindestens 8 Zeichen."

msgid "Invoiced time entries cannot be deleted."
msgstr "Abgerechnete Zeiteinträge können nicht gelöscht werden."

msgid "A timer is already running."
msgstr "Es läuft bereits ein Timer."

msgid "No timer is running."
msgstr "Es läuft kein Timer."

msgid "Timer is already paused."
msgstr "Der Timer ist bereits pausiert."

msgid "Timer is not paused."
msgstr "Der Timer ist nicht pausiert."

